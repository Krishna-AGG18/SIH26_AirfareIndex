{
  "name": "sih26-airfare-index",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"npm run dev --workspace frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": ".\\backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --app-dir backend",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "test": "npm run test --workspace frontend -- --run",
    "db:migrate": ".\\backend\\.venv\\Scripts\\python.exe -m alembic -c backend/alembic.ini upgrade head",
    "backend:install": "python -m pip install -e \"./backend[dev]\""
  },
  "devDependencies": {
    "@neon/config": "latest",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@neon/env": "^1.2.2"
  }
}
